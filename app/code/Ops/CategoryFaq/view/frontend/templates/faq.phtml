<?php
/** @var \Ops\CategoryFaq\Block\Faq $block */
if (!$block->shouldDisplayFaq()):
    return;
endif;

$faqItems = $block->getFaqItems();
if (empty($faqItems)):
    return;
endif;
?>
<section class="my-10 md:my-8 clear-both"
         x-data="{
             activeIndex: null,
             toggle(index) {
                 this.activeIndex = this.activeIndex === index ? null : index;
             }
         }"
>
    <div class="mb-5 md:mb-8 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-black m-0">FREQUENTLY ASKED QUESTION</h2>
    </div>
    <div class="flex flex-col gap-2.5">
        <?php foreach ($faqItems as $index => $item): ?>
            <div class="bg-[#f5f5f5] border border-gray-300 overflow-hidden relative">
                <button type="button"
                        class="w-full flex items-center justify-between gap-4 px-4 py-3 md:px-5 md:py-[15px] bg-[#f5f5f5] hover:bg-[#e8e8e8] text-left text-sm md:text-base font-bold uppercase text-black leading-normal transition-colors duration-200 outline-none select-none"
                        @click="toggle(<?= (int) $index ?>)"
                        :aria-expanded="activeIndex === <?= (int) $index ?>"
                >
                    <span class="flex-1 text-left"><?= $block->escapeHtml($item['question']) ?></span>
                    <span class="inline-flex items-center justify-center flex-shrink-0 font-bold text-black text-lg md:text-2xl w-[18px] transition-transform duration-300 ease-in-out"
                          :class="{ 'rotate-45': activeIndex === <?= (int) $index ?> }"
                    >+</span>
                </button>
                <div class="bg-[#f5f5f5]"
                     x-show="activeIndex === <?= (int) $index ?>"
                     x-collapse.duration.400ms
                     x-transition:enter="transition-opacity ease-out duration-300"
                     x-transition:enter-start="opacity-0"
                     x-transition:enter-end="opacity-100"
                     x-transition:leave="transition-opacity ease-in duration-300"
                     x-transition:leave-start="opacity-100"
                     x-transition:leave-end="opacity-0"
                     x-cloak
                >
                    <div class="bg-[#f5f5f5] text-black text-sm leading-relaxed px-4 pb-3 md:px-5 md:pb-5">
                        <?= /* @noEscape */ $item['answer'] ?>
                    </div>
                </div>
            </div>
        <?php endforeach; ?>
    </div>
</section>