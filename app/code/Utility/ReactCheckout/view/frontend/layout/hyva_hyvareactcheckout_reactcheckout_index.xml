<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Remove the original vendor's script block to prevent duplicate declarations -->
        <referenceBlock name="react.checkout.script" remove="true" />

        <!-- Add your custom script block -->
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template" name="react.checkout.script.custom" template="Utility_ReactCheckout::react-script.phtml">
                <arguments>
                    <argument name="csp_nonce_provider" xsi:type="object">FriendsOfHyva\ReactCheckout\ViewModel\CspNonceProvider</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>