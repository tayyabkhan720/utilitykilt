<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config/etc/system_file.xsd">
    <system>
        <section id="tjv_promo" translate="label" sortOrder="999"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>TJV Promotion Settings</label>
            <tab>sales</tab>
            <resource>Magento_Config::config</resource>
            
            <group id="buy_one_free_shipping" translate="label" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Buy One Get Shipping Free</label>
                
                <field id="enabled" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Buy One Get Shipping Free</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>tjv_promo/buy_one_free_shipping/enabled</config_path>
                </field>

               <field id="trigger_categories" translate="label comment" type="multiselect" sortOrder="20"
                    showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Trigger Categories</label>
                    <source_model>TJV\PromoShipping\Model\Config\Source\Categories</source_model>
                    <can_be_empty>1</can_be_empty>
                    <comment>Customer buys a product from ANY of these categories to activate the promo. Subcategories are included.</comment>
                </field>

               <field id="free_shipping_categories" translate="label comment" type="multiselect" sortOrder="30"
                    showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Free Shipping Categories</label>
                    <source_model>TJV\PromoShipping\Model\Config\Source\Categories</source_model>
                    <can_be_empty>1</can_be_empty>
                    <comment>Products in these categories get free shipping when the trigger condition is met. Subcategories are included.</comment>
                </field>

                <field id="description" translate="label" type="label" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>How It Works</label>
                    <comment>
                        <![CDATA[
                        <strong>Example:</strong><br/>
                        Trigger: <code>123,456</code> (Shirts)<br/>
                        Free Shipping: <code>789</code> (Caps)<br/>
                        <strong>Result:</strong> Buy Shirt → Cap gets FREE SHIPPING
                        ]]>
                    </comment>
                </field>
            </group>
        </section>
    </system>
</config>