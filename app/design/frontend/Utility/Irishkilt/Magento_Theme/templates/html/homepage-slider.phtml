<section
    x-data="heroSlider()"
    x-init="init()"
    class="relative overflow-hidden"
>

    <!-- Slides -->
    <div
        class="flex transition-transform duration-700 ease-in-out"
        :style="`transform: translateX(-${active * 100}%);`"
    >

        <template x-for="(slide, index) in slides" :key="index">

            <div class="relative w-full shrink-0">
                <picture>
                    <source
                        media="(min-width:768px)"
                        :srcset="slide.image"
                    >

                    <img
                        :src="slide.image"
                        :alt="slide.alt"
                        :fetchpriority="index === 0 ? 'high' : 'auto'"
                        itemprop="image"
                        class="w-full h-auto object-cover"
                        :loading="index === 0 ? 'eager' : 'lazy'"
                    >
                </picture>

                <!-- Caption -->
                <div
                    class="absolute left-[6%] top-1/2 w-[90%] max-w-[360px] -translate-y-1/2 bg-[rgba(18,53,36,0.72)] px-7 py-[22px] font-sans text-white"
                >
                    <span
                        class="mb-1.5 block text-[13px] tracking-[1px] text-[#c9a227]"
                        x-text="slide.label"
                    ></span>

                    <h2
                        class="mb-3 font-serif text-[26px] leading-[1.25]"
                        x-text="slide.title"
                    ></h2>
                    <a
                        :href="slide.url"
                        class="inline-block rounded-sm bg-[#c9a227] px-4 py-2 text-[13px] font-bold tracking-[1px] text-[#123524] transition hover:bg-[#bfa12b]"
                        x-text="slide.button"
                    ></a>
                </div>
            </div>

        </template>

    </div>

    <!-- Previous Arrow -->
    <button
        type="button"
        @click="prev()"
        aria-label="Previous slide"
        class="absolute left-4 top-1/2 flex h-[38px] w-[38px] -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-[18px] text-[#123524] transition hover:bg-white"
    >
        &#10094;
    </button>

    <!-- Next Arrow -->
    <button
        type="button"
        @click="next()"
        aria-label="Next slide"
        class="absolute right-4 top-1/2 flex h-[38px] w-[38px] -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-[18px] text-[#123524] transition hover:bg-white"
    >
        &#10095;
    </button>

    <!-- Dots -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-3">
        <template x-for="(slide, index) in slides" :key="index">
            <button
                type="button"
                @click="go(index)"
                :aria-label="`Go to slide ${index + 1}`"
                class="h-3 w-3 rounded-full transition"
                :class="active === index
                    ? 'w-[calc(var(--spacing)*7)] bg-primary'
                    : 'bg-white'"
            ></button>
        </template>
    </div>

</section>

<script>
function heroSlider() {
    return {
        slides: [
            {
                image: '/media/wysiwyg/iks-web-banner.jpg',
                alt: 'Irish Kilt Shop banner',
                label: 'EST. FAMILY OWNED · BLACKBURN UK',
                title: 'Authentic Scottish & Irish Kilts',
                button: 'Shop Now',
                url: '#'
            },
            {
                image: '/media/wysiwyg/iks-web-banner.jpg',
                alt: 'Tartan kilt',
                label: 'MOST POPULAR',
                title: 'Tartan Kilts — 1,500+ Patterns',
                button: 'Shop Tartan',
                url: '#'
            },
            {
                image: '/media/wysiwyg/iks-web-banner.jpg',
                alt: "Women's kilt",
                label: "WOMEN'S COLLECTION",
                title: 'Stylish Cuts for Any Occasion',
                button: 'Shop Women',
                url: '#'
            }
        ],

        active: 0,
        timer: null,

        init() {
            this.start();
        },

        start() {
            this.timer = setInterval(() => {
                this.next();
            }, 922000);
        },

        next() {
            this.active = (this.active + 1) % this.slides.length;
            this.restart();
        },

        prev() {
            this.active = (this.active - 1 + this.slides.length) % this.slides.length;
            this.restart();
        },

        go(index) {
            this.active = index;
            this.restart();
        },

        restart() {
            clearInterval(this.timer);
            this.start();
        }
    }
}
</script>