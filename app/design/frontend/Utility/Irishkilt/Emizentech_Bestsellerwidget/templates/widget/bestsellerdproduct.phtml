<?php
/**
 * Bestseller Products Widget
 * - Single product load pass (no duplicate getLoadProduct calls)
 * - Batch category name resolution (1 query total, not N+1)
 * - Deepest-level category picked per product (most specific, not root)
 * - Per-product discount percentage badge
 */

if ($exist = ($this->getBestsellerProduct() && $this->getBestsellerProduct()->getPageSize())) {
    $fet_prodcollection = $this->getBestsellerProduct();
    $productIds = [4015, 4032, 3971, 3899];
    $mode = 'grid';
    $type = 'widget-bestseller-grid';
    $image = 'bestseller_products_content_widget_grid';
}
?>
<?php
$myBlock = \Magento\Framework\App\ObjectManager::getInstance()->get('Emizentech\Bestsellerwidget\Block\Currentcat');
$current = 228;
if ($myBlock) {
    $currentCategory = $myBlock->getCurrentCategory();
    if ($currentCategory) {
        $current = $currentCategory->getLevel();
    }
}
?>
<div class="block widget block-bestseller-products">
    <div class="block-content">
        <div class="products-grid grid">
            <div class="product-items widget-bestseller-grid hidden">
                <li class="product-item">
                    <div class="product-item-info">
                        <a href=""></a>
                    </div>
                </li>
            </div>
        </div>
    </div>
</div>
<?php if ($exist && $current == 228): ?>
<div class="block widget block-bestseller-products <?php /* @escapeNotVerified */ echo $mode; ?>">
    <?php if (count($productIds) < 0): ?>
        <div class="message info empty"><div><?php echo __('We can\'t find products matching the selection.') ?></div></div>
    <?php else: ?>
        <?php
            // ---------------------------------------------------------------
            // Step 1: Load products ONCE, filter unsaleable/invisible up front.
            // ---------------------------------------------------------------
            $loadedProducts = [];
            foreach ($productIds as $productId) {
                $_product = $this->getLoadProduct($productId);
                if (!$_product
                    || !$_product->isSaleable()
                    || $_product->getVisibility() == \Magento\Catalog\Model\Product\Visibility::VISIBILITY_NOT_VISIBLE
                ) {
                    continue;
                }
                $loadedProducts[] = $_product;
            }

            // ---------------------------------------------------------------
            // Step 2: Collect every category id assigned to every product.
            // ---------------------------------------------------------------
            $categoryIdsByProductId = [];
            $allCategoryIds = [];
            foreach ($loadedProducts as $_p) {
                $catIds = $_p->getCategoryIds();
                if (!empty($catIds)) {
                    $categoryIdsByProductId[$_p->getId()] = $catIds;
                    $allCategoryIds = array_merge($allCategoryIds, $catIds);
                }
            }
            $allCategoryIds = array_unique($allCategoryIds);

            // ---------------------------------------------------------------
            // Step 3: ONE query to fetch name + level for every category
            // referenced across all products.
            // ---------------------------------------------------------------
            $categoryDataById = [];
            if (!empty($allCategoryIds)) {
                $categoryCollection = \Magento\Framework\App\ObjectManager::getInstance()
                    ->create(\Magento\Catalog\Model\ResourceModel\Category\CollectionFactory::class)
                    ->create()
                    ->addAttributeToSelect(['name', 'level'])
                    ->addFieldToFilter('entity_id', ['in' => $allCategoryIds]);

                foreach ($categoryCollection as $_category) {
                    $categoryDataById[$_category->getId()] = [
                        'name'  => $_category->getName(),
                        'level' => (int) $_category->getLevel(),
                    ];
                }
            }

            // ---------------------------------------------------------------
            // Step 4: Per product, pick the DEEPEST (most specific) assigned
            // category.
            // ---------------------------------------------------------------
            $categoryNameByProductId = [];
            foreach ($categoryIdsByProductId as $productId => $catIds) {
                $deepestLevel = -1;
                $deepestName = '';
                foreach ($catIds as $catId) {
                    if (isset($categoryDataById[$catId]) && $categoryDataById[$catId]['level'] > $deepestLevel) {
                        $deepestLevel = $categoryDataById[$catId]['level'];
                        $deepestName = $categoryDataById[$catId]['name'];
                    }
                }
                $categoryNameByProductId[$productId] = $deepestName;
            }
        ?>
        <div class="block-content">
            <?php /* @escapeNotVerified */ echo '<!-- ' . $image . '-->' ?>
            <div class="products-<?php /* @escapeNotVerified */ echo $mode; ?> <?php /* @escapeNotVerified */ echo $mode; ?>">
                <ol class="grid grid-cols-2 gap-4 sm:grid-cols-2 md:grid-cols-4 max-w-[1400px] mx-auto gap-6 product-items widget-new-grid product-items <?php /* @escapeNotVerified */ echo $type; ?>">
                    <?php $iterator = 1; ?>
                    <?php foreach ($loadedProducts as $_product): ?>
                    <?php /* @escapeNotVerified */ echo($iterator++ == 1) ? '<li class="product-item">' : '</li><li class="product-item">' ?>
                    <div class="product-item-info">
                        <?php
                            $image_url = $block->imageHelperObj()->init($_product, 'product_page_image_small')
                                ->setImageFile($_product->getFile())
                                ->getUrl();

                            $categoryName = $categoryNameByProductId[$_product->getId()] ?? '';

                            // --- Per-product discount percentage ---
                            $regularPrice = (float) $_product->getPriceInfo()->getPrice('regular_price')->getAmount()->getValue();
                            $finalPrice = (float) $_product->getPriceInfo()->getPrice('final_price')->getAmount()->getValue();
                            $hasDiscount = $finalPrice < $regularPrice && $regularPrice > 0;
                            $discountPercent = $hasDiscount
                                ? (int) round((($regularPrice - $finalPrice) / $regularPrice) * 100)
                                : 0;
                        ?>
                        <a href="<?php /* @escapeNotVerified */ echo $_product->getProductUrl() ?>" class="product-item-photo">
                            <img src="<?php echo $image_url; ?>" alt="<?php echo $this->escapeHtml($_product->getName()) ?>"
                                 class="product-image-photo w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110" />
                        </a>
                        <div class="product-item-details p-4 text-center">
                            <?php if ($categoryName): ?>
                                <span class="block text-[12.5px] font-semibold mb-1.5 text-[#1c4a34]">
                                    <?= $block->escapeHtml($categoryName) ?>
                                </span>
                            <?php endif; ?>

                            <?php
                                $reviewSummaryHtml = $this->getReviewsSummaryHtml($_product, 'short');
                                $reviewCount = (int) $_product->getReviewsCount();
                                $ratingSummary = (int) $_product->getRatingSummary();
                            ?>
                            <?php if ($reviewSummaryHtml && $reviewCount > 0): ?>
                                <div class="mb-1 flex items-center gap-2">
                                    <span class="[&_.rating-summary]:gap-0 [&_.rating-summary_svg]:h-2 [&_.rating-summary_svg]:w-2 [&_.rating-summary_svg]:fill">
                                        <?= /* @noEscape */ $reviewSummaryHtml ?>
                                    </span>
                                    <span class="summary-it">
                                        <?= $block->escapeHtml(__('%1% · %2 reviews', $ratingSummary, $reviewCount)) ?>
                                    </span>
                                </div>
                            <?php endif; ?>

                            <strong class="product-item-name text-[15px] mb-2.5 leading-[1.35] normal-case tracking-normal text-[#1b1b1b] block truncate">
                                <a title="<?php echo $block->escapeHtml($_product->getName()) ?>" href="<?php /* @escapeNotVerified */ echo $_product->getProductUrl() ?>" class="product-item-link">
                                    <?php echo $block->escapeHtml($_product->getName()) ?>
                                </a>
                            </strong>

                            <div class="flex items-center justify-center gap-2">
                                <?php echo $this->getProductPriceHtml($_product, $type); ?>
                                <?php if ($hasDiscount): ?>
                                    <span class="text-xs font-bold text-white bg-[#a4342a] px-2 py-0.5 rounded-full">
                                        -<?= $discountPercent ?>%
                                    </span>
                                <?php endif; ?>
                            </div>

                            <div class="product-item-actions hidden">
                                <div class="actions-primary">
                                    <a class="action tocart primary" href="<?= /* @escapeNotVerified */ $_product->getProductUrl() ?>"><?= /* @escapeNotVerified */ __('Product Details') ?></a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <?php endforeach ?>
                    <?php if (!empty($loadedProducts)): ?></li><?php endif; ?>
                </ol>
            </div>
        </div>
    <?php endif; ?>
</div>
<?php endif; ?>