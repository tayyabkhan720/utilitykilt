<?php
/** @var \Magento\Store\Block\Switcher $block */
$stores = $block->getStores();
$currentStoreCode = $block->getCurrentStoreCode();
?>
<?php if (count($stores) > 1): ?>
<div class="relative" x-data="{ open: false }" @click.outside="open = false">
    <button
        type="button"
        @click="open = !open"
        class="flex items-center gap-1.5 px-2 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 focus:outline-none"
        :aria-expanded="open.toString()"
        aria-haspopup="true"
    >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 010 18 15 15 0 010-18z" />
        </svg>
        <span class="hidden sm:inline"><?= $block->escapeHtml($block->getStoreName()) ?></span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-150" :class="{ 'rotate-180': open }" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
    </button>

    <div
        x-show="open"
        x-cloak
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
        x-transition:leave="transition ease-in duration-100"
        x-transition:leave-start="opacity-100 scale-100"
        x-transition:leave-end="opacity-0 scale-95"
        class="absolute right-0 z-30 mt-2 w-52 origin-top-right rounded-md bg-white shadow-lg ring-1 ring-black/5 focus:outline-none"
    >
        <ul class="py-1" role="menu">
            <?php foreach ($stores as $_store): ?>
                <?php if ($_store->getCode() === $currentStoreCode): ?>
                    <li role="menuitem">
                        <span class="flex items-center justify-between px-4 py-2 text-sm font-semibold text-gray-900 bg-gray-50">
                            <?= $block->escapeHtml($_store->getName()) ?>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                        </span>
                    </li>
                <?php elseif ($_store->isActive()): ?>
                    <li role="menuitem">
                        
                            href="<?= $block->escapeUrl($block->getViewModel()->getTargetStoreRedirectUrl($_store)) ?>"
                            class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
                        >
                            <?= $block->escapeHtml($_store->getName()) ?>
                        </a>
                    </li>
                <?php endif; ?>
            <?php endforeach; ?>
        </ul>
    </div>
</div>
<?php endif; ?>