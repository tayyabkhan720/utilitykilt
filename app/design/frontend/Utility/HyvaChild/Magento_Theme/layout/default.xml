<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- 1. Footer Container Adjustments -->
        <referenceContainer name="footer-container">
            <block class="Magento\Newsletter\Block\Subscribe"
                   name="footer.newsletter.subscribe"
                   template="Magento_Newsletter::subscribe.phtml"
                   before="-" />
        </referenceContainer>

        <!-- 2. Header Container Adjustments (Injecting Topbar with View Model) -->
        <referenceContainer name="header-wrapper">
            <block class="Magento\Framework\View\Element\Template"
                   name="header.topbar"
                   template="Magento_Theme::html/topbar.phtml"
                   before="-">
                <arguments>
                    <!-- Injects the view model required by Hyvä to retrieve Account & Navigation details safely -->
                    <argument name="view_model" xsi:type="object">Hyva\Theme\ViewModel\Navigation</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
