<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="homepage.content"
                   template="Magento_Theme::html/homepage.phtml"
                   after="-"
                    />
            <block 
                class="Magento\Framework\View\Element\Template"
                name="homepage-product-slider"
                template="Magento_Catalog::product/slider/product-slider.phtml"
                after="homepage.gallery" 
                >
                <arguments>
                        <argument name="title" xsi:type="string" translate="true">Accesories</argument>
                        <argument name="category_ids" xsi:type="string">6</argument>
                        <!-- <argument name="column_count" xsi:type="number">5</argument> -->
                        <!-- <argument name="include_child_category_products" xsi:type="boolean">true</argument>-->
                        <argument name="page_size" xsi:type="string">8</argument>
                        <!-- <argument name="sort_attribute" xsi:type="string">position</argument>-->
                        <!-- <argument name="sort_direction" xsi:type="string">ASC</argument>-->
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>