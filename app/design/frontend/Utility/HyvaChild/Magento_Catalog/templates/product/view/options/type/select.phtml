<?php
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\CustomOption;
use Hyva\Theme\ViewModel\ProductPrice;
use Magento\Catalog\Block\Product\View\Options\Type\Select;
use Magento\Catalog\Pricing\Price\CustomOptionPrice;
use Magento\Framework\Escaper;
use TJV\HyvaMageworxSwatches\ViewModel\MageworxSwatch;

/** @var Select $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
$option = $block->getOption();
$product = $block->getProduct();

/** @var CustomOption $customOptionsViewModel */
$customOptionsViewModel = $viewModels->require(CustomOption::class);

/** @var MageworxSwatch $swatchViewModel */
$swatchViewModel = $viewModels->require(MageworxSwatch::class);

/** @var ProductPrice $productPriceViewModel */
$productPriceViewModel = $viewModels->require(ProductPrice::class);

$isSwatch = $swatchViewModel->isSwatchOption($option);
$alpineData = null;

if ($isSwatch) {
    $configValue = $product->getPreconfiguredValues()->getData('options/' . $option->getId());
    if (!is_array($configValue)) {
        $configValue = $configValue !== null ? [$configValue] : [];
    }

    $store = $product->getStore();
    $jsOptions = [];
    foreach ($option->getValues() as $value) {
        $valuePrice = $productPriceViewModel->getCustomOptionPrice($value, CustomOptionPrice::PRICE_CODE, $product);
        $jsOptions[] = [
            'id' => (string) $value->getOptionTypeId(),
            'title' => $value->getTitle(),
            'formattedPrice' => $valuePrice ? $swatchViewModel->formatPrice((float) $valuePrice, $store) : '',
        ];
    }

    $alpineData = sprintf(
        '{ selectedValues: %s, options: %s, isMultiple: %s, toggle(value) { let val = value.toString(); if (this.isMultiple) { if (this.selectedValues.includes(val)) { this.selectedValues = this.selectedValues.filter(v => v !== val); } else { this.selectedValues.push(val); } } else { this.selectedValues = [val]; } let selectEl = this.$refs["option-%s"]; Array.from(selectEl.options).forEach(o => { o.selected = this.selectedValues.includes(o.value); }); selectEl.dispatchEvent(new Event("change", { bubbles: true })); } }',
        json_encode(array_map('strval', array_values($configValue))),
        json_encode($jsOptions),
        $option->getType() === \Magento\Catalog\Model\Product\Option::OPTION_TYPE_MULTIPLE ? 'true' : 'false',
        $option->getId()
    );
}
?>
<div class="mb-4 w-full md:w-[calc(50%-0.5rem)]"
     <?php if ($isSwatch): ?>

     x-data="<?= $escaper->escapeHtmlAttr($alpineData) ?>"
     :class="'w-full md:w-full '"
     <?php endif; ?>
>
    <label
        class="mb-1 text-base font-normal"
        for="options_<?= $escaper->escapeHtmlAttr($option->getId()) ?>"
    >
        <span><?= $escaper->escapeHtml($option->getTitle()) ?></span>
        <?php if ($option->getIsRequire()): ?>
            <span class="sup text-sm">*</span>
        <?php endif; ?>
        <?php if ($isSwatch): ?>
            <span class="ml-1 font-normal italic text-gray-600"
                  x-text="selectedValues.length > 0
                          ? options.filter(o => selectedValues.includes(o.id)).map(o => o.title + (o.formattedPrice ? ' (' + o.formattedPrice + ')' : '')).join(', ')
                          : ''"
            ></span>
        <?php endif; ?>
    </label>
    <div>
        <?= $customOptionsViewModel->getOptionHtml($option, $product); ?>
    </div>
</div>