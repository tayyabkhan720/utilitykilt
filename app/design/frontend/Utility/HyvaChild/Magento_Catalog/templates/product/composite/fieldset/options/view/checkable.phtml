<?php
/**
 * Overrides Hyvä default checkable.phtml to add MageWorx swatch support.
 */
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\ProductPrice;
use Magento\Catalog\Block\Product\View\Options\Type\Select\Checkable;
use Magento\Catalog\Model\Product\Option;
use Magento\Catalog\Pricing\Price\CustomOptionPrice;
use Magento\Framework\Escaper;
use TJV\HyvaMageworxSwatches\ViewModel\MageworxSwatch;

/**
 * @var Checkable $block
 * @var Escaper $escaper
 * @var ViewModelRegistry $viewModels
 */

$product = $block->getProduct();

/** @var ProductPrice $productPriceViewModel */
$productPriceViewModel = $viewModels->require(ProductPrice::class);

/** @var MageworxSwatch $swatchViewModel */
$swatchViewModel = $viewModels->require(MageworxSwatch::class);

$option = $block->getOption();

if ($option):
    $configValue = $block->getPreconfiguredValue($option);
    $optionType = $option->getType();
    $arraySign = $optionType === Option::OPTION_TYPE_CHECKBOX ? '[]' : '';
    $isSwatch = $swatchViewModel->isSwatchOption($option);
    $store = $product->getStore();
    ?>

<div class="options-list nested<?= $isSwatch ? ' flex flex-wrap gap-3' : '' ?>"
     id="options-<?= $escaper->escapeHtmlAttr($option->getId()) ?>-list">

    <?php if ($optionType === Option::OPTION_TYPE_RADIO && !$option->getIsRequire() && !$isSwatch): ?>
    <div class="field choice">
        <input type="radio"
               id="options_<?= $escaper->escapeHtmlAttr($option->getId()) ?>"
               class="radio product-custom-option"
               name="options[<?= $escaper->escapeHtmlAttr($option->getId()) ?>]"
               value=""
               checked
               x-on:change="updateCustomOptionValue(
                $dispatch, '<?= $escaper->escapeHtmlAttr($option->getId()) ?>', $event.target
               )"
        >
        <label class="label text-left"
               for="options_<?= $escaper->escapeHtmlAttr($option->getId()) ?>">
            <span><?= $escaper->escapeHtml(__('None')) ?></span>
        </label>
    </div>
    <?php endif; ?>

    <?php foreach ($option->getValues() as $value): ?>
        <?php
        $checked = '';
        if ($arraySign) {
            $checked = is_array($configValue) && in_array($value->getOptionTypeId(), $configValue) ? 'checked' : '';
        } else {
            $checked = $configValue == $value->getOptionTypeId() ? 'checked' : '';
        }

        $optionId = $option->getId() . '_' . $value->getOptionTypeId();

        $valuePrice = $productPriceViewModel->getCustomOptionPrice($value, CustomOptionPrice::PRICE_CODE, $product);
        if ($productPriceViewModel->displayPriceInclAndExclTax()) {
            $valueBasePrice = $value->getPrice(true);
        }

        $swatchType = $isSwatch ? $swatchViewModel->getSwatchType($value) : null;
        $swatchImageUrl = $isSwatch && in_array($swatchType, ['image', 'color'])
            ? $swatchViewModel->getSwatchImageUrl($value)
            : null;
        ?>

        <div class="field choice<?= $isSwatch ? ' !mb-0' : '' ?>">
            <input type="<?= $escaper->escapeHtmlAttr($optionType) ?>"
                   class="<?= $isSwatch
                       ? 'sr-only peer'
                       : ($optionType === Option::OPTION_TYPE_RADIO ? 'form-radio' : 'form-checkbox')
                         . ' product-custom-option' ?>"
                   name="options[<?= $escaper->escapeHtmlAttr($option->getId()) ?>]<?= /* @noEscape */ $arraySign ?>"
                   id="options_<?= $escaper->escapeHtmlAttr($optionId) ?>"
                   value="<?= $escaper->escapeHtmlAttr($value->getOptionTypeId()) ?>"
                   <?= $escaper->escapeHtml($checked) ?>
                   <?php if ($option->getIsRequire()): ?>
                       required
                       data-required
                       oninvalid="this.setCustomValidity(this.dataset.validationMessage)"
                       oninput="this.setCustomValidity('')"
                       data-validation-message="<?= $escaper->escapeHtmlAttr(__("Please select one of the options.")) ?>"
                   <?php endif; ?>
                   data-price-amount="<?= $escaper->escapeHtmlAttr($valuePrice) ?>"
                   <?php if ($productPriceViewModel->displayPriceInclAndExclTax()): ?>
                   data-base-price-amount="<?= $escaper->escapeHtmlAttr($valueBasePrice ?? 0) ?>"
                   <?php endif; ?>
                   data-price-type="<?= $escaper->escapeHtmlAttr($value->getPriceType()) ?>"
                   data-option-id="<?= $escaper->escapeHtmlAttr($optionId) ?>"
                   x-ref="option-<?= $escaper->escapeHtmlAttr($optionId) ?>"
                   x-on:change="updateCustomOptionValue(
                    $dispatch, '<?= $escaper->escapeHtmlAttr($optionId) ?>', $event.target
                   )"
            >

            <?php if ($isSwatch): ?>
                <label for="options_<?= $escaper->escapeHtmlAttr($optionId) ?>"
                       class="test123 cursor-pointer inline-flex flex-col items-center gap-1 rounded border-2 border-gray-200 p-1 peer-checked:border-primary peer-checked:ring-2 peer-checked:ring-primary peer-focus:outline peer-focus:outline-2"
                >
                    <?php if ($swatchType === 'text'): ?>
                        <span class="px-3 py-1 text-sm"
                              style="max-width: <?= (int) $swatchViewModel->getTextSwatchMaxWidth() ?>px;">
                            <?= $escaper->escapeHtml($value->getTitle()) ?>
                        </span>
                    <?php else: ?>
                        <span class="block rounded"
                              style="
                                width: <?= (int) $swatchViewModel->getSwatchWidth() ?: 32 ?>px;
                                height: <?= (int) $swatchViewModel->getSwatchHeight() ?: 32 ?>px;
                                <?php if ($swatchType === 'color'): ?>
                                    background-color: <?= $escaper->escapeHtmlAttr($value->getBaseImage()) ?>;
                                <?php else: ?>
                                    background-image: url('<?= $escaper->escapeUrl($swatchImageUrl) ?>');
                                    background-size: cover;
                                    background-position: center;
                                <?php endif; ?>
                              "
                        ></span>
                    <?php endif; ?>

                    <?php if ($swatchViewModel->isShowSwatchTitle() && $swatchType !== 'text'): ?>
                        <span class="text-xs"><?= $escaper->escapeHtml($value->getTitle()) ?></span>
                    <?php endif; ?>

                    <?php if ($swatchViewModel->isShowSwatchPrice() && $valuePrice): ?>
                        <span class="text-xs text-gray-500">
                            <?= $swatchViewModel->formatPrice((float) $valuePrice, $store) ?>
                        </span>
                    <?php endif; ?>
                </label>
            <?php else: ?>
                <label class="label text-left"
                       for="options_<?= $escaper->escapeHtmlAttr($optionId) ?>"
                       x-html="updateOptionPrice('<?= $escaper->escapeJs($optionId) ?>', $el)"
                >
                    <span><?= $escaper->escapeHtml($value->getTitle()) ?></span>
                    <span><?= /* @noEscape */ $block->formatPrice($value) ?></span>
                </label>
            <?php endif; ?>
        </div>
    <?php endforeach; ?>
</div>
<?php endif; ?>